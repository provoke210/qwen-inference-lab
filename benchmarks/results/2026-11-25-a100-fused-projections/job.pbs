#!/bin/bash -l
#PBS -N qil-fuse
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=110gb
#PBS -l walltime=00:45:00
#PBS -j oe
# Fused QKV and gate/up projections: qil before (main) and after, against vLLM's default mode,
# for one model and dtype on one GPU. QIL_TESTS=1 also runs the GPU test suite on the new tree.
R=${QIL_ROOT:?set QIL_ROOT to the cluster work directory}
model=${QIL_MODEL:?}; dtype=${QIL_DTYPE:?}
OUT=$R/results-fuse/$model-$dtype
module load miniforge3/25.3.1
export LD_PRELOAD=/app/apps/miniforge3/25.3.1/lib/libstdc++.so.6
source $R/venv-vllm/bin/activate
export HF_HOME=$R/hf HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export TRITON_CACHE_DIR=$R/triton/vllm-env VLLM_CACHE_ROOT=$R/vllm-cache VLLM_USE_FLASHINFER_SAMPLER=0
rm -rf $OUT; mkdir -p $OUT
printf 'step\texit\tseconds\n' > $OUT/status.tsv
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv > $OUT/environment.txt
run() {
  local step=$1 tree=$2; shift 2
  echo "RUNNING $step" > $OUT/current.txt
  local t0=$SECONDS
  ( cd $R/$tree && PYTHONPATH=$R/$tree timeout 900 "$@" ) > $OUT/$step.log 2>&1
  printf '%s\t%s\t%s\n' $step $? $((SECONDS-t0)) >> $OUT/status.tsv
}
[ "$QIL_TESTS" = 1 ] && run pytest fuse python -m pytest -q --disable-warnings --junitxml=$OUT/pytest.xml
common="python -m benchmarks.compare_independent --model $R/models/$model --workload $R/workload.json \
  --dtype $dtype --runs 3 --max-new-tokens 128"
qil="--backend qil --batch-decode --selective-logits --decode-attention paged"
run $model-$dtype-before-graph main $common $qil --cuda-graph --output $OUT/$model-$dtype-before-graph.json
run $model-$dtype-after-eager fuse $common $qil --output $OUT/$model-$dtype-after-eager.json
run $model-$dtype-after-graph fuse $common $qil --cuda-graph --output $OUT/$model-$dtype-after-graph.json
run $model-$dtype-vllm-default fuse $common --backend vllm --vllm-mode default --gpu-memory-utilization 0.85 \
  --output $OUT/$model-$dtype-vllm-default.json
echo DONE > $OUT/current.txt
